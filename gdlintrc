# Settings of gdlint (gdtoolkit), the GDScript linter checked in CI.
# Lint locally with:  gdlint $(git ls-files '*.gd')
#
# All default rules apply, except:

disable:
  # A limit of 20 public methods does not fit test files (one method per
  # test), the assertion library, or implementations of the larger service
  # contracts, and gdlint cannot set it per folder.
  - max-public-methods

# The GDScript style guide's limit.
max-line-length: 100

excluded_directories: !!set
  .git: null
  .godot: null
  build: null
